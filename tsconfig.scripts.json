{
  // Optional local type-check for scripts/ dev tooling — NOT used by `next build`.
  // Browser scripts needing Playwright are excluded; run those via npx tsx.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.mts", "scripts/types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "scripts/verify-idb-cache-browser-staging.ts"
  ]
}
